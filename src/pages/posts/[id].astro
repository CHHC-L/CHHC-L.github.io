---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TagList from '../../components/TagList.astro';
import {
  excerpt,
  formatDate,
  getPosts,
  isArchived,
  postUrl,
  topicTags,
  type Post,
} from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    // Paging stays within the timeline, or within the archive.
    const group = posts.filter((p) => isArchived(p) === isArchived(post));
    const i = group.indexOf(post);
    return {
      params: { id: post.id },
      // newest first, so the next-newer post comes before this one
      props: { post, newer: group[i - 1], older: group[i + 1] },
    };
  });
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, date, updated } = post.data;
const published = formatDate(date);
const edited = updated && formatDate(updated);
---

<Base title={title} description={excerpt(post)}>
  <Fragment slot="head">
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={date.toISOString()} />
  </Fragment>
  <article class="post">
    <header class="post-header">
      <h1 lang={post.data.lang}>{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}>{published}</time>
        {edited && edited !== published && <span>Updated {edited}</span>}
        {isArchived(post) && <a href="/archive/">Archived</a>}
        <TagList tags={topicTags(post)} />
      </div>
    </header>
    <div class="prose" lang={post.data.lang}>
      <Content />
    </div>
    {
      (older || newer) && (
        <nav class="post-nav" aria-label="Older and newer posts">
          {older && (
            <a class="older" href={postUrl(older)}>
              <span>Older</span>
              <strong lang={older.data.lang}>{older.data.title}</strong>
            </a>
          )}
          {newer && (
            <a class="next" href={postUrl(newer)}>
              <span>Newer</span>
              <strong lang={newer.data.lang}>{newer.data.title}</strong>
            </a>
          )}
        </nav>
      )
    }
  </article>
</Base>
