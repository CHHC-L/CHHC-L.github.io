---
import Base from '../layouts/Base.astro';
import { EMAIL, GITHUB } from '../consts';

const rss = new URL('/rss.xml', Astro.site);

// Newest first.
const experience = [
  { dates: 'Sep 2026 – Present', place: 'Non-convex Tech', role: 'Quantitative Developer' },
  { dates: 'Aug 2024 – Apr 2026', place: 'University of Michigan', role: 'B.S.E. in Industrial and Operations Engineering' },
  { dates: 'Sep 2022 – Aug 2026', place: 'Shanghai Jiao Tong University', role: 'B.S.E. in Electrical and Computer Engineering' },
];
---

<Base title="About">
  <article class="column">
    <header class="post-header">
      <h1>About</h1>
      <p class="name">Tianqin Jiao / <span lang="zh-CN">焦天勤</span></p>
    </header>

    <section aria-labelledby="experience">
      <h2 id="experience">Experience</h2>
      <dl class="rows">
        {
          experience.map(({ dates, place, role }) => (
            <div>
              <dt>{dates}</dt>
              <dd>
                <strong>{place}</strong>
                <span>{role}</span>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="contact">
      <h2 id="contact">Contact</h2>
      <dl class="rows">
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
        </div>
        <div>
          <dt>GitHub</dt>
          <dd><a href={GITHUB}>{GITHUB.split('/').pop()}</a></dd>
        </div>
        <div>
          <dt>RSS</dt>
          <dd><a href="/rss.xml">{rss.host + rss.pathname}</a></dd>
        </div>
      </dl>
    </section>
  </article>
</Base>

<style>
  .name {
    margin: 0;
    color: var(--muted);
    font-size: 1.05rem;
  }

  h2 {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.2rem;
    font-weight: 900;
  }

  .rows {
    margin: 0;
  }

  .rows > div {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    column-gap: 1rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--rule);
  }

  .rows > div:first-child {
    border-top: 0;
  }

  dt {
    color: var(--muted);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    padding-top: 0.12rem;
  }

  dd {
    margin: 0;
  }

  dd strong {
    display: block;
    font-weight: 700;
  }

  dd span {
    color: var(--muted);
  }

  @media (max-width: 32rem) {
    .rows > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
