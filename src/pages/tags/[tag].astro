---
import Base from '../../layouts/Base.astro';
import YearIndex from '../../components/YearIndex.astro';
import { getPosts, postCount, topicTags, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap(topicTags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((post) => topicTags(post).includes(tag)) },
  }));
}

interface Props {
  posts: Post[];
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Base title={`#${tag}`}>
  <div class="lede">
    <h1>#{tag}</h1>
    <p>{postCount(posts.length)}. <a href="/tags/">All tags</a></p>
  </div>
  <YearIndex posts={posts} />
</Base>

<style>
  h1 {
    text-autospace: no-autospace;
  }
</style>
