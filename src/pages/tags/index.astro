---
import Base from '../../layouts/Base.astro';
import { getPosts, postCount, tagUrl, topicTags } from '../../lib/posts';

const posts = await getPosts();
const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of topicTags(post)) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'en'));
---

<Base title="Tags">
  <div class="lede">
    <h1>Tags</h1>
    <p>标签</p>
  </div>
  <div class="column">
    <ul class="post-list">
      {
        tags.map(([tag, count]) => (
          <li>
            <span class="count">{postCount(count)}</span>
            <a class="title tag-name" href={tagUrl(tag)}>
              #{tag}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
