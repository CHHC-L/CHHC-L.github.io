---
import Base from '../layouts/Base.astro';
import YearIndex from '../components/YearIndex.astro';
import { getPosts, isArchived } from '../lib/posts';

const posts = (await getPosts()).filter(isArchived);
---

<Base title="Archive">
  <div class="lede">
    <h1>Archive</h1>
    <p>存档</p>
  </div>
  {posts.length > 0 ? <YearIndex posts={posts} /> : <p class="empty column">Nothing archived yet.</p>}
</Base>

<style>
  .empty {
    color: var(--muted);
  }
</style>
